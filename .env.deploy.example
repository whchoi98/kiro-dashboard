# kiro-dashboard — CDK deploy-time environment template
# ----------------------------------------------------------------
# This file is read by `infra/bin/app.ts` during `npx cdk deploy`.
# It is separate from `.env.local`, which is used by `npm run dev`
# (runtime on the developer's machine).
#
# USAGE:
#   cp .env.deploy.example .env.deploy
#   # edit .env.deploy with your account values (see table below)
#   set -a; source .env.deploy; set +a
#   cd infra && npx cdk deploy --all
#
# `.env.deploy` is git-ignored so your account-specific values never
# get committed.
#
# For every variable below, omitting it falls back to the upstream
# maintainer defaults (which only work in the maintainer's AWS
# account). A fork/operator deploying to their own account will want
# to override every row unless noted.

# ----------------------------------------------------------------
# CDK target account + region
# ----------------------------------------------------------------
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=ap-northeast-2

# ----------------------------------------------------------------
# Kiro User Activity Report source
# ----------------------------------------------------------------
# S3 bucket where Kiro drops the User Activity Report CSV files.
# Setting this also opts-in the `KiroDashboardCatalog` stack which
# creates the `titanlog.user_report` Glue table over this bucket.
ATHENA_DATA_BUCKET_NAME=my-kiro-activity-report-bucket

# Prefix under the data bucket. Kiro's default layout is below —
# substitute your account id.
S3_REPORT_PREFIX=q-user-log/AWSLogs/123456789012/KiroLogs/user_report/us-east-1/

# ----------------------------------------------------------------
# Athena query results
# ----------------------------------------------------------------
# Bucket Athena writes query results into. Must exist in your
# account. May equal ATHENA_DATA_BUCKET_NAME.
ATHENA_RESULTS_BUCKET_NAME=my-athena-results-bucket
# Optional — defaults to `athena-results`.
# ATHENA_RESULTS_PREFIX=athena-results

# ----------------------------------------------------------------
# Glue catalog names
# ----------------------------------------------------------------
# Optional — defaults match the existing hardcoded values.
# ATHENA_DATABASE_NAME=titanlog
# GLUE_TABLE_NAME_OVERRIDE=user_report

# ----------------------------------------------------------------
# IAM Identity Center
# ----------------------------------------------------------------
# Find in AWS console → IAM Identity Center → Settings.
IDENTITY_STORE_ID=d-xxxxxxxxxxxx

# ----------------------------------------------------------------
# Athena/Bedrock/IdC query region (Catalog stack lives here)
# ----------------------------------------------------------------
# Optional — defaults to us-east-1 to match the ECS task's runtime
# `AWS_REGION`. Only change this if you've modified EcsStack to
# point the container at a different region.
# ATHENA_REGION=us-east-1
