{
  "chat.defaultAgent": "kiro-dashboard-dev",
  "chat.enableKnowledge": true,
  "chat.enableCodeIntelligence": true,
  "chat.enableSubagent": true,
  "chat.enableTodoList": true,
  "chat.enableThinking": true,
  "knowledge.indexType": "fast",
  "knowledge.defaultExcludePatterns": [
    "node_modules/**",
    "infra/node_modules/**",
    ".next/**",
    "infra/cdk.out/**",
    ".git/**",
    "screenshot/**",
    "img/**",
    "package-lock.json",
    "tsconfig.tsbuildinfo"
  ]
}
